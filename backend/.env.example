# ── The only key the batch command needs ──
# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tokens per minute the account allows for that model. The run is paced to stay under it;
# too high means 429s and waiting, too low means a slower run than necessary.
GROQ_TPM=8000

# Reasoning models charge their thinking to the same budget as the reply. These calls are
# extraction and formatting, so the lowest setting is both faster and cheaper.
GROQ_REASONING_EFFORT=low

# ── Server only. Not read by `npm run evaluate`. ──
MONGODB_URI=

# At least 32 characters each, and different from one another. Generate a pair with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The origin allowed through CORS, and the only one cookies are sent to.
FRONTEND_URL=http://localhost:3000
PORT=4000

# `production` turns on `secure` and `sameSite=none` cookies, which is what cross-origin
# Vercel -> Render needs and what localhost over http must not have.
NODE_ENV=development

# ── Retrieval ──
# Private and loopback addresses are rejected in production.
# Set true locally so the crawler can reach the fixture sites on :8099.
ALLOW_PRIVATE_URLS=false
